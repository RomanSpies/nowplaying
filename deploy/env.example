# /etc/nowplaying/env — environment for nowplaying.service
# Plain HTTP on loopback; TLS terminates at nginx (deploy/nginx-nowplaying.conf).
NP_BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://nowplaying:CHANGE_ME@localhost/nowplaying
NP_DEVICE_NAME=NowPlaying Widget
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=nowplaying
NP_ALLOWED_ORIGINS=https://rospies.dev,https://*.rospies.dev
NP_MIN_PLAY_MS=30000
RUST_LOG=info,librespot=warn
